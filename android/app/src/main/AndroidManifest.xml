<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ requires this to be requested at runtime; without it the
         morning affirmation silently never appears. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        FOREGROUND_SERVICE and FOREGROUND_SERVICE_MEDIA_PLAYBACK were declared
        here so narration could keep playing with the screen locked. They have
        been removed, because the app does not do that.

        There is no Service in this project, no MediaSession, and no call to
        startForeground anywhere. Audio is a plain HTMLAudioElement inside the
        Capacitor WebView. Declaring the permission never made background
        playback work — it only made Play demand a video demonstrating a
        feature that does not exist, which is a rejection waiting to happen.

        To actually support playback with the screen off, add a media-session
        plugin that runs a real foreground service, then put these two back and
        record the video Play asks for. Permission first, feature never, is the
        wrong order.
    -->

    <!-- Lets audio survive Doze while a session is actually playing. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
