<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static rather than generated: this app has a handful of public URLs and every
  other route sits behind auth, so a build-time generator would be more moving
  parts than the problem deserves. Update by hand when a public page is added.

  The namespace below must be sitemaps.org — PLURAL. It read sitemap.org until
  2026-10-09, which is not a real schema, and Search Console rejects the whole
  file as an unsupported format when the namespace doesn't match. Every URL here
  was invisible to Google for as long as that typo existed. Don't "tidy" it.

  Thank-you pages are deliberately absent: they are noindex and reaching one
  without paying would be meaningless anyway.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://trymanifestationai.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://trymanifestationai.com/get</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://trymanifestationai.com/stack/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://trymanifestationai.com/reset/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://trymanifestationai.com/auth</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
