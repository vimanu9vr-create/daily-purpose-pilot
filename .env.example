# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# PUBLIC — these ship inside the browser bundle. Safe to share; they are not
# secrets, and Supabase is designed around that. Row-level security, not key
# secrecy, is what protects user data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Same three, for the server render. Kept separate so a future server-only
# value can be added here without accidentally acquiring a VITE_ prefix and
# being published to every visitor.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — never prefix these with VITE_. Anything VITE_ is public.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics. Optional: leave blank and events are logged to the console in
# development and dropped in production. See src/lib/analytics.ts.
VITE_ANALYTICS_ENDPOINT=
